DEFINE SCHEMA

RECORD TYPE MoteMac (
    "___recordID" REFERENCE QUERYABLE,
    name STRING,
    lastSeen TIMESTAMP,
    GRANT CREATE TO "_icloud",
    GRANT READ, WRITE TO "_creator"
);

RECORD TYPE MoteEvent (
    "___recordID" REFERENCE QUERYABLE,
    kind STRING QUERYABLE,
    title STRING,
    macName STRING,
    occurredAt TIMESTAMP QUERYABLE SORTABLE,
    replyMac STRING,
    replyUntil TIMESTAMP,
    GRANT CREATE TO "_icloud",
    GRANT READ, WRITE TO "_creator"
);

RECORD TYPE MoteReply (
    "___recordID" REFERENCE,
    body ENCRYPTED STRING,
    eventID STRING,
    macID STRING,
    status STRING,
    message STRING,
    expiresAt TIMESTAMP,
    GRANT CREATE TO "_icloud",
    GRANT READ, WRITE TO "_creator"
);
